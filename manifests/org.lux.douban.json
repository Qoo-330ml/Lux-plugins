{
  "formatVersion": 1,
  "id": "org.lux.douban",
  "name": "豆瓣元数据插件",
  "description": "从豆瓣提供电影、剧集、图片、人物和预告片元数据。公开搜索无需配置；详情接口可配置豆瓣客户端凭据。",
  "version": "__VERSION__",
  "apiVersion": 1,
  "runtime": {"kind": "process", "entrypoint": "__ENTRYPOINT__"},
  "type": "metadata",
  "category": "SCRAPER",
  "supportedItemTypes": ["Movie", "Series", "Season"],
  "capabilities": ["metadata.search", "metadata.get", "metadata.images", "metadata.credits", "metadata.externalIds", "metadata.trailers"],
  "configFields": [
    {
      "key": "apiKey",
      "label": "豆瓣 API Key",
      "type": "password",
      "required": false,
      "sensitive": true,
      "description": "可选。默认使用插件内置的公开 WeChat 客户端凭据；填写后覆盖默认值。用于详情、评分、人物和图片请求。"
    },
    {
      "key": "apiSecret",
      "label": "豆瓣 API Secret",
      "type": "password",
      "required": false,
      "sensitive": true,
      "description": "可选。与 API Key 同时填写时启用签名的 Frodo 客户端。"
    },
    {
      "key": "requestIntervalMs",
      "label": "请求间隔（毫秒）",
      "type": "number",
      "required": false,
      "sensitive": false,
      "defaultValue": 1500,
      "minimum": 0,
      "maximum": 60000,
      "description": "豆瓣请求之间的最小间隔，建议保留默认值。"
    }
  ],
  "permissions": {
    "network": [
      "frodo.douban.com",
      "movie.douban.com",
      "img1.doubanio.com",
      "img2.doubanio.com",
      "img3.doubanio.com",
      "img4.doubanio.com",
      "img5.doubanio.com",
      "img6.doubanio.com",
      "img7.doubanio.com",
      "img8.doubanio.com",
      "img9.doubanio.com"
    ],
    "filesystem": ["plugin-cache"]
  },
  "files": []
}
