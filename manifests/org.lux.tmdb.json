{
  "formatVersion": 1,
  "id": "org.lux.tmdb",
  "name": "TMDb 元数据插件",
  "description": "从 TMDb 提供 Emby 风格电影、剧集和图片元数据。",
  "version": "__VERSION__",
  "apiVersion": 1,
  "runtime": {"kind": "process", "entrypoint": "__ENTRYPOINT__"},
  "type": "metadata",
  "category": "SCRAPER",
  "providerKey": "tmdb",
  "aliases": ["tmdb"],
  "supportedItemTypes": ["Movie", "Series", "Season", "Episode", "Person", "BoxSet"],
  "capabilities": ["metadata.search", "metadata.get", "metadata.bundle", "metadata.images", "metadata.credits", "metadata.externalIds", "metadata.trailers"],
  "configFields": [{
    "key": "apiKey",
    "label": "TMDb API Key",
    "type": "password",
    "required": false,
    "sensitive": true,
    "description": "可选。留空时使用 TMDb 插件自己的默认凭据。"
